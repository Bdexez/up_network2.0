# Base de données
# Valeurs par défaut de docker-compose.yml (port hôte 5433 pour éviter tout
# conflit avec un PostgreSQL déjà installé). `cp .env.example .env` suffit alors.
DATABASE_URL="postgresql://upnet:upnet@localhost:5433/up_network?schema=public"

# JWT — obligatoire, l'API refuse de démarrer sans. Mettez une valeur longue
# et aléatoire en production.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Serveur
PORT=3000

# Front autorisé pour le CORS (plusieurs valeurs séparées par des virgules)
FRONTEND_URL="http://localhost:5173,http://localhost:5174"

# Envoi d'e-mails. Sans SMTP_HOST, les messages sont journalisés au lieu d'être
# envoyés — pratique en développement, à renseigner en production.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASSWORD=""
SMTP_FROM="facturation@democorp.fr"
