generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Coeur : multi-société, utilisateurs, rôles & permissions
// ---------------------------------------------------------------------------

model Company {
  id       Int     @id @default(autoincrement())
  name     String
  code     String  @unique
  isActive Boolean @default(true)

  // Coordonnées reprises sur les documents commerciaux (devis, factures…)
  address   String?
  zipCode   String?
  city      String?
  country   String?
  email     String?
  phone     String?
  vatNumber String?

  /// Taux de TVA proposé par défaut sur les nouveaux produits.
  defaultVatRate Float @default(20)

  /// Autorise une sortie de stock supérieure au disponible. Faux par défaut :
  /// un stock négatif est presque toujours une erreur de saisie.
  allowNegativeStock Boolean @default(false)

  /// Délai de règlement appliqué aux factures, en jours.
  paymentTermsDays Int @default(30)

  /// Devise de tenue de comptes. Les documents peuvent être libellés dans une
  /// autre devise ; leurs montants sont alors aussi convertis dans celle-ci
  /// pour que les états consolidés restent additionnables.
  currency String @default("EUR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles          Role[]
  users          UserCompany[]
  partners       Partner[]
  products       Product[]
  quotes         Quote[]
  orders         Order[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  warehouses     Warehouse[]
  stockMovements StockMovement[]
  counters       DocumentCounter[]
  attachments    Attachment[]
  projects       Project[]
  employees      Employee[]
  expenseReports ExpenseReport[]
  leads          Lead[]
  opportunities  Opportunity[]
  activities     Activity[]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  username     String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  userType     String   @default("internal")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userCompanies      UserCompany[]
  refreshTokens      RefreshToken[]
  attachments        Attachment[]
  employeeRecords    Employee[]      @relation("EmployeeAccount")
  leaveDecisions     LeaveRequest[]  @relation("LeaveDecider")
  expenseDecisions   ExpenseReport[] @relation("ExpenseDecider")
  ownedProjects      Project[]       @relation("ProjectOwner")
  assignedTasks      Task[]          @relation("TaskAssignee")
  timeEntries        TimeEntry[]
  quotes             Quote[]
  orders             Order[]
  invoices           Invoice[]
  purchaseOrders     PurchaseOrder[]
  payments           Payment[]
  stockMovements     StockMovement[]
  ownedLeads         Lead[]          @relation("LeadOwner")
  ownedOpportunities Opportunity[]   @relation("OpportunityOwner")
  ownedActivities    Activity[]      @relation("ActivityOwner")
}

/// Jeton de rafraîchissement, stocké haché : une fuite de la base ne permet
/// pas de rejouer les sessions.
model RefreshToken {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Société active au moment de l'émission, pour rendre un jeton équivalent.
  companyId    Int
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Rotation : le jeton qui a remplacé celui-ci. Permet de détecter le rejeu
  /// d'un jeton déjà échangé, signe d'un vol.
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Objets auxquels une pièce jointe peut se rattacher.
enum AttachmentEntity {
  PARTNER
  QUOTE
  ORDER
  INVOICE
  PURCHASE_ORDER
  PRODUCT
  PROJECT
}

/// Document rattaché à une fiche : bon de livraison signé, contrat, photo…
/// Le fichier vit sur disque ; la base ne garde que sa description.
model Attachment {
  id       Int              @id @default(autoincrement())
  entity   AttachmentEntity
  entityId Int

  fileName    String
  mimeType    String
  size        Int
  /// Chemin relatif au dossier de stockage, cloisonné par société.
  storagePath String
  description String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  uploadedById Int
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, entity, entityId])
}

model Role {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  companyId    Int
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  userCompanies UserCompany[]

  @@unique([name, companyId])
}

model Permission {
  id           Int              @id @default(autoincrement())
  moduleName   String
  resourceName String
  actionName   String
  description  String?
  isSystem     Boolean          @default(false)
  roles        RolePermission[]

  @@unique([moduleName, resourceName, actionName])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  granted      Boolean    @default(true)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserCompany {
  id         Int      @id @default(autoincrement())
  userId     Int
  companyId  Int
  roleId     Int?
  isDefault  Boolean  @default(false)
  assignedAt DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role       Role?    @relation(fields: [roleId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// ---------------------------------------------------------------------------
// Numérotation des documents
// ---------------------------------------------------------------------------

enum DocumentType {
  QUOTE
  ORDER
  INVOICE
  CREDIT_NOTE
  PURCHASE_ORDER
}

/// Compteur par société, type de document et année : DE2026-0001, FA2026-0042…
/// L'incrément est fait dans la transaction qui crée le document.
model DocumentCounter {
  id        Int          @id @default(autoincrement())
  companyId Int
  type      DocumentType
  year      Int
  value     Int          @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, year])
}

// ---------------------------------------------------------------------------
// Tiers & catalogue
// ---------------------------------------------------------------------------

enum PartnerType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Partner {
  id        Int         @id @default(autoincrement())
  name      String
  type      PartnerType @default(CUSTOMER)
  email     String?
  phone     String?
  address   String?
  zipCode   String?
  city      String?
  country   String?
  website   String?
  vatNumber String?
  isActive  Boolean     @default(true)

  /// Délai de règlement négocié ; à défaut, celui de la société s'applique.
  paymentTermsDays Int?
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contacts       Contact[]
  quotes         Quote[]
  orders         Order[]
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  opportunities  Opportunity[]
  activities     Activity[]
  leads          Lead[]
  projects       Project[]

  @@index([companyId])
}

/// Interlocuteurs rattachés à un tiers.
model Contact {
  id        Int      @id @default(autoincrement())
  firstName String?
  lastName  String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  partnerId Int
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
}

enum ProductType {
  PRODUCT
  SERVICE
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  sku         String
  description String?
  type        ProductType @default(PRODUCT)

  /// Prix de vente hors taxes.
  price     Float
  /// Prix d'achat, sert à la valorisation du stock et à la marge.
  costPrice Float @default(0)
  vatRate   Float @default(20)

  /// Les services ne sont pas suivis en stock.
  manageStock Boolean @default(true)
  /// Seuil déclenchant l'alerte de réapprovisionnement.
  stockAlert  Float   @default(0)

  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteLines         QuoteLine[]
  orderLines         OrderLine[]
  invoiceLines       InvoiceLine[]
  purchaseOrderLines PurchaseOrderLine[]
  stocks             Stock[]
  stockMovements     StockMovement[]

  // La référence est unique par société, pas globalement.
  @@unique([companyId, sku])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Cycle de vente : devis -> commande -> facture -> paiements
//
// Chaque document porte ses propres lignes. C'est volontaire : une facture
// figée ne doit pas changer parce qu'on a modifié la commande ou le tarif
// catalogue après coup. Les lignes sont donc recopiées à chaque conversion.
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  VALIDATED
  SIGNED
  REFUSED
  BILLED
}

model Quote {
  id     Int         @id @default(autoincrement())
  ref    String
  status QuoteStatus @default(DRAFT)

  date       DateTime  @default(now())
  validUntil DateTime?
  notes      String?

  totalHT  Float @default(0)
  totalVat Float @default(0)
  totalTTC Float @default(0)

  /// Devise du document. Les totaux ci-dessus y sont exprimés.
  currency     String @default("EUR")
  /// Taux de conversion vers la devise de la société, figé à l'émission.
  exchangeRate Float  @default(1)
  /// Totaux convertis dans la devise société, pour les états consolidés.
  baseTotalHT  Float  @default(0)
  baseTotalTTC Float  @default(0)

  companyId   Int
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partnerId   Int
  partner     Partner @relation(fields: [partnerId], references: [id])
  createdById Int
  createdBy   User    @relation(fields: [createdById], references: [id])

  lines  QuoteLine[]
  orders Order[]

  /// Verrou optimiste : incrémenté à chaque écriture. Une modification qui
  /// s'appuie sur une version périmée est refusée plutôt qu'écrasée.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, ref])
  @@index([companyId, status])
}

model QuoteLine {
  id       Int   @id @default(autoincrement())
  quoteId  Int
  quote    Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position Int   @default(0)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  /// Libellé figé au moment de l'ajout ; une ligne libre n'a pas de produit.
  label           String
  quantity        Float  @default(1)
  unitPrice       Float
  discountPercent Float  @default(0)
  vatRate         Float  @default(20)

  totalHT  Float @default(0)
  totalVat Float @default(0)
  totalTTC Float @default(0)

  @@index([quoteId])
}

enum OrderStatus {
  DRAFT
  VALIDATED
  SHIPPED
  BILLED
  CANCELLED
}

model Order {
  id     Int         @id @default(autoincrement())
  ref    String
  status OrderStatus @default(DRAFT)

  date         DateTime  @default(now())
  deliveryDate DateTime?
  shippedAt    DateTime?
  notes        String?

  totalHT  Float @default(0)
  totalVat Float @default(0)
  totalTTC Float @default(0)

  /// Devise du document. Les totaux ci-dessus y sont exprimés.
  currency     String @default("EUR")
  /// Taux de conversion vers la devise de la société, figé à l'émission.
  exchangeRate Float  @default(1)
  /// Totaux convertis dans la devise société, pour les états consolidés.
  baseTotalHT  Float  @default(0)
  baseTotalTTC Float  @default(0)

  companyId   Int
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partnerId   Int
  partner     Partner @relation(fields: [partnerId], references: [id])
  createdById Int
  createdBy   User    @relation(fields: [createdById], references: [id])

  /// Devis d'origine, quand la commande vient d'une conversion.
  quoteId Int?
  quote   Quote? @relation(fields: [quoteId], references: [id])

  lines    OrderLine[]
  invoices Invoice[]

  /// Verrou optimiste : incrémenté à chaque écriture. Une modification qui
  /// s'appuie sur une version périmée est refusée plutôt qu'écrasée.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, ref])
  @@index([companyId, status])
}

model OrderLine {
  id       Int   @id @default(autoincrement())
  orderId  Int
  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int   @default(0)

  /// Quantités déjà traitées : permettent les expéditions et facturations
  /// partielles sans document de livraison séparé.
  shippedQuantity  Float @default(0)
  invoicedQuantity Float @default(0)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  label           String
  quantity        Float  @default(1)
  unitPrice       Float
  discountPercent Float  @default(0)
  vatRate         Float  @default(20)

  totalHT  Float @default(0)
  totalVat Float @default(0)
  totalTTC Float @default(0)

  @@index([orderId])
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InvoiceType {
  /// Facture de vente ordinaire.
  INVOICE
  /// Avoir : corrige une facture émise, sans jamais la réécrire.
  CREDIT_NOTE
}

model Invoice {
  id     Int           @id @default(autoincrement())
  ref    String
  type   InvoiceType   @default(INVOICE)
  status InvoiceStatus @default(DRAFT)

  date    DateTime  @default(now())
  dueDate DateTime?
  notes   String?

  totalHT    Float @default(0)
  totalVat   Float @default(0)
  totalTTC   Float @default(0)
  /// Somme des paiements encaissés ; maintenue par PaymentsService.
  paidAmount Float @default(0)

  /// Suivi des relances d'impayé : niveau atteint et date du dernier envoi.
  reminderCount  Int       @default(0)
  lastReminderAt DateTime?

  /// Date du dernier envoi au client, tous canaux confondus.
  sentAt DateTime?

  /// Devise du document. Les totaux ci-dessus y sont exprimés.
  currency     String @default("EUR")
  /// Taux de conversion vers la devise de la société, figé à l'émission.
  exchangeRate Float  @default(1)
  /// Totaux convertis dans la devise société, pour les états consolidés.
  baseTotalHT  Float  @default(0)
  baseTotalTTC Float  @default(0)

  pdfUrl String?

  companyId   Int
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partnerId   Int
  partner     Partner @relation(fields: [partnerId], references: [id])
  createdById Int
  createdBy   User    @relation(fields: [createdById], references: [id])

  /// Commande d'origine ; une facture peut aussi être créée directement.
  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id])

  /// Pour un avoir : la facture qu'il corrige.
  creditedInvoiceId Int?
  creditedInvoice   Invoice?  @relation("InvoiceCredits", fields: [creditedInvoiceId], references: [id])
  creditNotes       Invoice[] @relation("InvoiceCredits")

  lines    InvoiceLine[]
  payments Payment[]

  /// Verrou optimiste : incrémenté à chaque écriture. Une modification qui
  /// s'appuie sur une version périmée est refusée plutôt qu'écrasée.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, ref])
  @@index([companyId, status])
}

model InvoiceLine {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position  Int     @default(0)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  label           String
  quantity        Float  @default(1)
  unitPrice       Float
  discountPercent Float  @default(0)
  vatRate         Float  @default(20)

  totalHT  Float @default(0)
  totalVat Float @default(0)
  totalTTC Float @default(0)

  @@index([invoiceId])
}

enum PaymentMethod {
  TRANSFER
  CARD
  CHECK
  CASH
  DIRECT_DEBIT
  OTHER
}

model Payment {
  id        Int           @id @default(autoincrement())
  amount    Float
  method    PaymentMethod @default(TRANSFER)
  date      DateTime      @default(now())
  reference String?
  notes     String?

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Achats & stock
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id     Int                 @id @default(autoincrement())
  ref    String
  status PurchaseOrderStatus @default(DRAFT)

  date         DateTime  @default(now())
  expectedDate DateTime?
  receivedAt   DateTime?
  notes        String?

  totalHT  Float @default(0)
  totalVat Float @default(0)
  totalTTC Float @default(0)

  /// Devise du document. Les totaux ci-dessus y sont exprimés.
  currency     String @default("EUR")
  /// Taux de conversion vers la devise de la société, figé à l'émission.
  exchangeRate Float  @default(1)
  /// Totaux convertis dans la devise société, pour les états consolidés.
  baseTotalHT  Float  @default(0)
  baseTotalTTC Float  @default(0)

  companyId   Int
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId  Int
  supplier    Partner @relation(fields: [supplierId], references: [id])
  createdById Int
  createdBy   User    @relation(fields: [createdById], references: [id])

  /// Entrepôt crédité à la réception.
  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  lines PurchaseOrderLine[]

  /// Verrou optimiste : incrémenté à chaque écriture. Une modification qui
  /// s'appuie sur une version périmée est refusée plutôt qu'écrasée.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, ref])
  @@index([companyId, status])
}

model PurchaseOrderLine {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  position        Int           @default(0)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  label           String
  quantity        Float  @default(1)
  unitPrice       Float
  discountPercent Float  @default(0)
  vatRate         Float  @default(20)

  totalHT  Float @default(0)
  totalVat Float @default(0)
  totalTTC Float @default(0)

  @@index([purchaseOrderId])
}

model Warehouse {
  id          Int     @id @default(autoincrement())
  name        String
  code        String
  address     String?
  city        String?
  description String?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)

  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks         Stock[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// Quantité d'un produit dans un entrepôt. Toujours modifiée en même temps
/// qu'un StockMovement, dans la même transaction.
model Stock {
  id          Int   @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Float @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

/// Journal des mouvements : chaque variation de stock y laisse une trace.
model StockMovement {
  id                Int               @id @default(autoincrement())
  type              StockMovementType
  /// Signée : positive pour une entrée, négative pour une sortie.
  quantity          Float
  /// Quantité en stock après le mouvement, pour relire l'historique.
  resultingQuantity Float             @default(0)
  reason            String?
  /// Document à l'origine du mouvement, ex. « CO2026-0004 ».
  documentRef       String?

  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  companyId   Int
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById Int
  createdBy   User    @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Ressources humaines : employés, congés, notes de frais
// ---------------------------------------------------------------------------

model Employee {
  id         Int     @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  position   String?
  /// Service ou département, en texte libre : une table dédiée serait
  /// disproportionnée pour une PME.
  department String?

  hireDate DateTime?
  endDate  DateTime?
  isActive Boolean   @default(true)

  /// Solde de congés payés, en jours. Décrémenté à l'approbation.
  paidLeaveBalance Float @default(25)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Compte applicatif associé, si l'employé se connecte à l'ERP.
  userId Int?
  user   User? @relation("EmployeeAccount", fields: [userId], references: [id])

  leaveRequests  LeaveRequest[]
  expenseReports ExpenseReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un compte ne peut tenir qu'une fiche par société — mais la même personne
  /// peut être salariée de deux sociétés du même ERP.
  @@unique([companyId, userId])
  @@index([companyId, isActive])
}

enum LeaveType {
  PAID
  RTT
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id     Int         @id @default(autoincrement())
  type   LeaveType   @default(PAID)
  status LeaveStatus @default(PENDING)

  startDate DateTime
  endDate   DateTime
  /// Nombre de jours ouvrés décomptés, calculé à la création.
  days      Float
  reason    String?

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  decidedById  Int?
  decidedBy    User?     @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REFUSED
  REIMBURSED
}

model ExpenseReport {
  id     Int           @id @default(autoincrement())
  ref    String
  status ExpenseStatus @default(DRAFT)

  /// Mois concerné, au premier jour du mois.
  period DateTime
  notes  String?

  totalHT  Float @default(0)
  totalVat Float @default(0)
  totalTTC Float @default(0)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  decidedById Int?
  decidedBy   User?     @relation("ExpenseDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?

  lines ExpenseLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, ref])
  @@index([companyId, status])
}

enum ExpenseCategory {
  TRAVEL
  MEAL
  ACCOMMODATION
  SUPPLIES
  MILEAGE
  OTHER
}

model ExpenseLine {
  id       Int             @id @default(autoincrement())
  category ExpenseCategory @default(OTHER)

  date        DateTime
  description String
  amountHT    Float
  vatRate     Float    @default(20)
  amountVat   Float    @default(0)
  amountTTC   Float    @default(0)

  reportId Int
  report   ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Projets, tâches et temps passé
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  CLOSED
}

model Project {
  id     Int           @id @default(autoincrement())
  ref    String
  name   String
  status ProjectStatus @default(DRAFT)

  description String?
  startDate   DateTime?
  endDate     DateTime?

  /// Budget en heures ; 0 signifie « non suivi ».
  budgetHours Float @default(0)
  /// Tarif horaire facturé, repris sur les temps facturables.
  hourlyRate  Float @default(0)

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Client du projet, s'il est réalisé pour un tiers.
  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  ownerId Int?
  owner   User? @relation("ProjectOwner", fields: [ownerId], references: [id])

  tasks       Task[]
  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, ref])
  @@index([companyId, status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id     Int        @id @default(autoincrement())
  name   String
  status TaskStatus @default(TODO)

  description    String?
  dueDate        DateTime?
  estimatedHours Float     @default(0)
  position       Int       @default(0)

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId Int?
  assignee   User? @relation("TaskAssignee", fields: [assigneeId], references: [id])

  timeEntries TimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

/// Temps passé, saisi par un utilisateur sur un projet ou une de ses tâches.
model TimeEntry {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  hours         Float
  description   String?
  /// Refacturable au client. Les temps internes ne le sont pas.
  billable      Boolean  @default(true)
  /// Heures déjà reprises sur une facture : évite de facturer deux fois.
  invoicedHours Float    @default(0)

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId Int?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId, date])
  @@index([userId, date])
}

// ---------------------------------------------------------------------------
// Addon CRM : pistes, opportunités, activités
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum OpportunityStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
}

enum ActivityStatus {
  PLANNED
  DONE
  CANCELLED
}

model Lead {
  id             Int        @id @default(autoincrement())
  name           String
  companyName    String?
  contactName    String?
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NEW)
  estimatedValue Float      @default(0)
  description    String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ownerId Int?
  owner   User? @relation("LeadOwner", fields: [ownerId], references: [id])

  // Renseignés lors de la conversion piste -> client
  convertedPartnerId Int?
  convertedPartner   Partner?  @relation(fields: [convertedPartnerId], references: [id])
  convertedAt        DateTime?

  opportunities Opportunity[]
  activities    Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
}

model Opportunity {
  id                Int              @id @default(autoincrement())
  name              String
  description       String?
  stage             OpportunityStage @default(QUALIFICATION)
  amount            Float            @default(0)
  probability       Int              @default(10)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id])

  ownerId Int?
  owner   User? @relation("OpportunityOwner", fields: [ownerId], references: [id])

  activities Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, stage])
}

model Activity {
  id          Int            @id @default(autoincrement())
  type        ActivityType   @default(TASK)
  subject     String
  description String?
  status      ActivityStatus @default(PLANNED)
  dueDate     DateTime?
  completedAt DateTime?

  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  ownerId Int?
  owner   User? @relation("ActivityOwner", fields: [ownerId], references: [id])

  leadId Int?
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  opportunityId Int?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  partnerId Int?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
}
